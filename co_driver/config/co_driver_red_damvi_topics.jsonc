// red_damvi wiring + arbitration parameters.
//
// One line: **when localization collapses, hand over to gap_follow; come back
// only when it is fully healthy again.**
//
// This file owns everything that belongs to co_driver itself:
//   - which inputs and drives exist, and where they listen (wiring)
//   - the arbitration layer: weights W[j][i], bias b_j, response curves,
//     veto placements, per-drive hold_ms
//
// How the localization score itself is computed (timeouts, missing-topic
// policy, recovery-gate conditions) is the scorer's business and lives in
// config/localization_scoring.jsonc, merged over this file at load.
// Base settings (scoring / selection / postprocess) are in co_driver_red_damvi.yaml.
{
  "inputs": [
    {
      // /localization_confidence, published by both localization_pf and
      // slam_ours (absolute name in both, no prefix).
      //   std_msgs/Float64MultiArray, data = [stamp_sec, stamp_nanosec, confidence]
      // localization_confidence rather than the generic external_score: this
      // producer appends its five raw terms, and one of them (term_skip) is an
      // obstacle meter rather than a pose-quality meter. See the ignore_terms
      // note in localization_scoring.jsonc.
      "name": "localization",
      "type": "localization_confidence",
      "params": {
        "topic": "/localization_confidence",
        "index": 2,
        "stamp_indices": [0, 1],
        "state_topic": "/localization_pf/state"
      },
      // Response curve, shared default for all drives (overridden per drive below).
      // Fitted to measured confidence distributions (healthy-tracking p05 per
      // scene: icra .877 / 0522-2 .867 / 0526-1 .530 / busan2 .361 - the
      // thresholds must sit below the worst of them):
      //   in_min 0.02 : at or below this, score 0 (localization is gone)
      //   in_max 0.35 : at or above this, full marks (out of the danger band)
      // With the weights below and switch_margin 0.15 the handover lands at
      // confidence 0.171 falling / 0.226 rising. Re-fit if the producer's
      // confidence formula changes.
      "influence": {"weight": 0.0, "exp_mix": 1.0, "exp_k": 3.0, "in_min": 0.02, "in_max": 0.35}
    },

    {
      // Localization state machine: 0=Lost (or waiting for map), 1=Converging,
      // 2=Tracking. std_msgs/UInt8, latched, republished on transitions only.
      // Used as a gate, not a score: Lost instantly disqualifies pp_main.
      //
      // Topic name is per-stack: the real car (localization_pf) uses
      // /localization_pf/state, the slam_ours replay rig /slam_ours/state.
      // Silence closes the gate, so a wrong name pins the car on gap_follow -
      // loud and safe, never silently disabled.
      "name": "loc_state",
      "type": "localization_state",
      "params": {"topic": "/localization_pf/state"}
    },

    {
      // Early-degradation trip - the score curve saturates at in_max, so a
      // localization hovering at 0.25-0.45 (quietly wrong, not collapsed)
      // never reaches the score pathway's handover. This input watches the
      // raw confidence and disqualifies pp_main when it stays below the trip
      // bar for a sustained stretch (numbers in localization_scoring.jsonc).
      // Engaged only while Tracking - Lost/Converging belong to the state
      // veto and the recovery latch (a fresh attach legitimately sits below
      // the trip bar and must not be gated here).
      "name": "loc_trip",
      "type": "confidence_trip",
      "params": {
        "topic": "/localization_confidence",
        "index": 2,
        "state_topic": "/localization_pf/state"
      }
    },

    {
      // TWO GEOMETRY CHECKS, TWO ROLES - do not collapse them.
      //
      //   clearance  the drive is commanding a path into solid geometry, so
      //              its idea of where it is must be wrong. Leaving is fast,
      //              coming back is reluctant (clear_ms 2000).
      //   obstacles  the map is right and the raceline is right, something is
      //              simply lying in the way. Leaving is fast, coming back is
      //              prompt (clear_ms 700) - nothing was wrong with the drive.
      //
      // Same veto, different meaning, and therefore different patience about
      // trusting pp_main again.
      //
      // Geometry check, independent of localization: project pp_main's own
      // command along the commanded arc and see whether the live scan says
      // something solid is in the way.
      //
      // This is the only detector that survives a confidently wrong pose. If
      // global search attaches to the wrong branch of a fork, the straight
      // walls still match and the disagreeing sector is masked out by the
      // producer (zero particle consensus), so the whole disagreement lands in
      // term_skip - which the score deliberately excludes to stay immune to
      // passing vehicles. Confidence therefore reads healthy while the
      // raceline controller steers into the wrong branch.
      //
      // Its parameters are vehicle geometry and stopping distance rather than
      // localization tuning, so they sit here rather than in
      // localization_scoring.jsonc. wheelbase and vehicle_half_width match
      // gap_follow's own config (0.324 / 0.18).
      "name": "clearance",
      "type": "path_clearance",
      "params": {
        "topic": "/scan",
        "wheelbase": 0.324,
        "vehicle_half_width": 0.18,
        // how far ahead to look: lookahead_time x speed, bounded
        "lookahead_time": 1.0,
        "min_lookahead_m": 0.5,
        "max_lookahead_m": 3.0,
        // below this much free path along the command, the drive is blocked
        "min_clearance_m": 0.8,
        // a crawling command cannot run into anything soon
        "min_speed": 0.2,
        // stop projecting after this much heading change - a command is a
        // snapshot, not a trajectory. At full lock the arc is a 30 cm circle,
        // and following it further curls the corridor into whatever is beside
        // or behind the car (measured: two vetoes on the 0813 run from an
        // object off the right flank, reached only after 140 degrees of sweep,
        // with the path ahead open at 2.86 m). Gentle steering sweeps only a
        // few degrees, so normal driving is unaffected.
        "max_sweep_deg": 90.0,
        // One noisy sweep is not evidence. Clearing is deliberately slow: a
        // drive that commanded a path into structure keeps the veto until it
        // has commanded a clear one for five seconds.
        //
        // Five, not two, because returning costs ~2.2 s anyway (switch
        // cooldown plus selection margin) and anything under that floor is
        // absorbed by it. Measured at 2000 ms: clearance returned in 2.11 s
        // against the obstacle detour's 2.25 s - the intended asymmetry did
        // not exist. This is the knob that separates the two roles, so it has
        // to be above the floor to do anything.
        "block_ms": 200,
        "clear_ms": 5000,
        "timeout_ms": 500
      }
    },

    {
      // Obstacle avoidance, from the detector's clustered output rather than
      // the raw scan. Same question as clearance, better evidence: clusters
      // wider than 3 m (long walls) are dropped by the detector and never
      // arrive here, which /scan alone cannot do.
      //
      // Requires obstacle_context_msgs at build time and /obstacle_clusters at
      // run time. Without either, the input reports unavailable and, at
      // weight 0, the arbitration behaves exactly as if it were not configured.
      //
      // Trusted fields only: the detector measures its cluster geometry at
      // 0.77 cm inter-scan residual, but its motion estimates read 1-4 m/s on
      // static objects while driving, so speed / velocity / motion_label are
      // all ignored. See the header of src/scorers/obstacle_avoid.cpp.
      //
      // The knob here is a distance along the path, not a braking margin:
      // this fires on objects worth going around, while path_clearance asks
      // the last-moment question of whether there is still room. Neither is
      // tuned on track yet, and they should be tuned together, since a false
      // positive in either hands the car over.
      "name": "obstacles",
      "type": "obstacle_avoid",
      "params": {
        "topic": "/obstacle_clusters",
        "wheelbase": 0.324,
        "vehicle_half_width": 0.18,
        // Extra room either side of the vehicle when deciding "on the path".
        // 0.55 m is from the 0813 recording: the three real objects on that
        // track are only caught from 0.50 m upward, and 0.50-0.60 m all give
        // the same result, so this sits in the middle of the verified band.
        // Avoidance wants more room than "will just barely miss" - this is not
        // the last-moment check, that is path_clearance.
        "lateral_margin_m": 0.55,
        // an obstacle anywhere on the commanded path within this much travel
        // is reason to go around it (bounded, so it stays sane at any speed)
        //
        // The two bounds were widened after the 0813 joint run. They exist to
        // keep the window sane at the speed extremes, but set too tight they
        // close the graded band entirely, and the demand becomes a step:
        // measured over 18337 status samples, NOT ONE fell in the graded
        // 0.01-0.85 range - every non-zero sample was already past the veto.
        // At that run's 0.6-1.7 m/s the old min_trigger 1.0 clamped the
        // trigger while full urgency floated free, leaving well under half a
        // metre between "noticed" and "committed". The old max_trigger 4.0
        // does the same at the other end: past ~2.7 m/s the trigger stops
        // growing while full urgency keeps up with speed, and the band closes
        // again. 2.0 / 6.0 keeps at least ~1.2 m of graded approach from
        // 0.5 m/s to 6 m/s.
        //
        // This changes nothing in the mid range: at 2.5 m/s the trigger is
        // 1.5 x v = 3.75 m either way, so the commit distance the regression
        // suite pins (2.0 m static / deferred dynamic) is untouched.
        "trigger_time": 1.5,
        "min_trigger_m": 2.0,
        "max_trigger_m": 6.0,
        // Urgency is measured in time of travel, not metres, so speed decides
        // what counts as close: inside this many seconds of travel the demand
        // is full, and it fades out to the trigger distance. Seeing an
        // obstacle is not a reason to hand over - being about to arrive at
        // one is.
        //
        // full_urgency_time is deliberately NOT lowered to open the band -
        // it sets the commit distance, and at 2.5 m/s dropping 0.8 -> 0.6
        // would move the commit from 2.0 m to 1.5 m, i.e. 0.6 s of travel,
        // against a 200 ms detection hold plus a 300 ms blend. The band is
        // opened from the trigger end, where being early costs nothing but a
        // rising bar on the status stream.
        "full_urgency_time": 0.8,
        "min_full_urgency_m": 0.8,
        // DYNAMIC-labelled clusters get a shorter window, i.e. we commit to
        // the detour later. The label is velocity-derived and not reliable,
        // but it only appears when the relative speed is high, and something
        // moving fast may have moved on by the time we arrive. Using it only
        // to be MORE conservative means a wrong label costs nothing. Note the
        // car runs the detector in STATIC_ONLY mode, where DYNAMIC is
        // overwritten before publication - this is inert there until that
        // changes.
        "dynamic_urgency_scale": 0.6,
        // and never more than this much ground, whatever the speed. The
        // detector's false-DYNAMIC rate climbs with ego speed (5% below
        // 1 m/s, 31% at 5-6 m/s) exactly as the cost of a late commit climbs
        // with it. Scaling alone lets both grow together; this bounds it.
        "dynamic_delay_max_m": 0.5,
        // Confidence, not threat. max_dense_weight is a range-normalised
        // spatial accumulation over ~7 frames, independent of the velocity
        // estimates; low values are transient or noise clusters (the detector
        // measured a spurious corridor intrusion at 0.0 with 7 points). Real
        // objects on 0813 sit at p10 55.6 / median 80.4, so 20 is a floor that
        // rejects noise without touching them. It is NOT a wall filter -
        // structure scores higher on this field, not lower.
        "dense_full": 20.0,
        // Note: the detector zeroes max_dense_weight, observed_count,
        // is_wall_static and track_id when its odom input is unavailable.
        // An all-zero trust signature is read as "cannot measure" rather than
        // "not trustworthy", and the cluster is judged on geometry alone -
        // otherwise losing localization would quietly turn obstacle avoidance
        // off at exactly the wrong moment.
        // Drop single-frame flickers only. Higher would delay reacting to a
        // newly appeared object, which is exactly when reacting matters.
        "min_observed": 2,
        "max_sweep_deg": 90.0,
        "min_speed": 0.2,
        // Wall-labelled clusters are skipped - but the detector only considers
        // the label at 1.0 m and wider, so a wall fragment or guard-rail
        // section narrower than that arrives as an ordinary obstacle and will
        // be avoided. The fixed structure 0.75 m off the right flank in the
        // 0813 recording is 0.91 m wide and can never be labelled. This is a
        // partial filter, not wall rejection.
        "ignore_wall_static": true,
        // Off. What is an obstacle and what is structure is the detector's
        // call, not co_driver's - this node does not detect obstacles, it
        // receives them and decides only whether they sit on the commanded
        // path. The detector already drops anything wider than 3 m and labels
        // what it judges to be wall; second-guessing that with a width of my
        // own was overreach, and the measurements agreed: across five datasets
        // real objects and sub-1 m structure share the same width distribution
        // to two decimals, so no threshold here separates them anyway.
        //
        // Consequence, accepted by the user: an unlabelled wall fragment on
        // the path is avoided like any other obstacle. On 0813 that is 2 extra
        // handovers per run alongside the 3 real ones. Reacting to a wall
        // costs a little speed; deciding for ourselves that something is not
        // an obstacle risks driving into one.
        "max_width_m": 0.0,
        "min_point_count": 0,
        // Return once the path is clear - nothing was wrong with pp_main, it
        // was simply occupied. Contrast the clearance check's 5000 ms.
        //
        // 1200 ms, raised from 700. On the 0813 run the five detours each ran
        // 0.86-1.10 s of demand and every one of them returned at exactly
        // 1.50 s - the arbitration's switch_cooldown_ms, not this hold. That
        // is the wrong thing to be in charge of the return: the cooldown is a
        // flap guard that knows nothing about where the obstacle is, and at
        // 1.5 s the car can still be alongside it when pp_main resumes and
        // steers back toward the raceline. 1200 ms puts this hold above the
        // cooldown floor, so the return is once again driven by the obstacle
        // having gone past - 2.4-4.8 m of travel at 2-4 m/s, comfortably
        // clear of anything the detector reports as a cluster.
        "block_ms": 200,
        "clear_ms": 1200,
        "timeout_ms": 500
      }
    },

    {
      // Return latch - keeps pp_main out until localization has been fully
      // healthy for a sustained stretch (conditions in localization_scoring.jsonc).
      "name": "recovery",
      "type": "recovery_gate",
      "params": {
        "confidence_topic": "/localization_confidence",
        "confidence_index": 2,
        "state_topic": "/localization_pf/state"
      }
    }
  ],

  // hold_ms = how long the last command stays trusted (~3-5x the topic period).
  // Past it the drive goes inactive and drops out of ranking and selection.
  "drives": [
    {
      // PPcontroller - map and raceline based; needs localization to mean anything
      "name": "pp_main",
      "topic": "/drive_main",
      // 450 ms, raised from 300. PPcontroller publishes at 100 Hz, but on the
      // 0813 run it dropped out five times for 305-335 ms - just past a 300 ms
      // hold, which disqualified a controller that was alive and handed the
      // car to gap_follow for no reason. 450 ms clears the worst measured gap
      // by ~115 ms and still catches a genuinely dead controller inside half a
      // second.
      "hold_ms": 450,
      // -4.5 cancels the obstacle input's +4.5 when the path is clear, so this
      // drive's logit is unchanged from the calibrated 3.0*phi(confidence).
      // Changing one without the other moves every localization threshold.
      "bias": -4.5,
      "enabled": true,
      "influence": {
        // W = +3.0: full confidence -> z = 3.0, zero confidence -> z = 0.0
        "localization": {"weight": 3.0, "exp_mix": 1.0, "exp_k": 3.0, "in_min": 0.02, "in_max": 0.35},
        // Lost (or silence) disqualifies pp_main outright; weight 0 = veto only
        "loc_state": {"weight": 0.0, "exp_mix": 0.0, "veto_below": 0.25},
        // early-degradation trip (see localization_scoring.jsonc); veto only
        "loc_trip": {"weight": 0.0, "exp_mix": 0.0, "veto_below": 0.5},
        // return latch (see localization_scoring.jsonc); weight 0 = veto only
        "recovery": {"weight": 0.0, "exp_mix": 0.0, "veto_below": 0.5},
        // geometry veto: the commanded path runs into something solid.
        // Only pp_main carries it - vetoing every candidate at once would
        // leave nothing to drive with and fall through to timeout_stop.
        "clearance": {"weight": 0.0, "exp_mix": 0.0, "veto_below": 0.5},
        // Obstacles enter as a SCORE, not a gate. The input reports how clear
        // the commanded path is (1 = nothing to avoid, 0 = must avoid), and
        // the weight turns that into a contribution the softmax weighs.
        //
        // The bias below is -4.5 to match: with a clear path the contribution
        // is +4.5 and the two cancel, so z_pp_main is exactly 3.0*phi(conf)
        // as before and every calibrated localization threshold is untouched.
        // Only an actual obstacle moves the balance, by up to -4.5. Against
        // gap_follow's floor that flips the selection at a demand of about
        // 0.85, which is why veto_below sits at 0.15 - the same point,
        // expressed as a hard gate so a certain obstacle also gets the
        // immediate-handover path instead of waiting on margin and cooldown.
        "obstacles": {"weight": 4.5, "exp_mix": 0.0, "veto_below": 0.15}
      }
    },
    {
      // gap_follow - reactive on /scan alone; unaffected by localization.
      // bias 1.0 is its floor score when localization is gone; W = -1.5 makes
      // it step aside once confidence recovers (z = 1.0 - 1.5*phi).
      "name": "gap_follow",
      "topic": "/drive_gf",
      "hold_ms": 200,
      "bias": 1.0,
      "enabled": true,
      "influence": {
        "localization": {"weight": -1.5, "exp_mix": 1.0, "exp_k": 3.0, "in_min": 0.02, "in_max": 0.35}
      }
    }
  ]
}
