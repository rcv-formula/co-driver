// 복귀 직후 잠깐만 도와주는 값들.
//
// gap_loc 에서 pp_main 으로 차를 돌려주는 그 순간, 지도 컨트롤러가 이미 크게
// 꺾어달라고 하고 있으면 - 즉 차가 자기가 원하는 자세에서 멀리 있으면 - 미분
// 이득을 잠깐 올렸다가 되돌립니다. 붙는 동안만 반응을 세게 하고, 붙고 나면
// 원래 값으로 돌아가야 하니 시간 제한이 있는 것입니다.
//
// co_driver 안에서 계산하는 게 아니라 상대 노드의 ROS 파라미터를 바꿉니다.
// pure_pursuit 은 K_d 를 런타임 변경 대상으로 열어두고 있고 (USAGE_GUIDE.md 의
// kRuntimeParameterNames), 바꾼 값은 다음 제어 주기부터 반영됩니다.
//
// 별도 스레드에서 돕니다. 파라미터 서비스 왕복은 수십 ms 가 걸릴 수 있고,
// hold_ms 동안 기다려야 하므로 판단 주기 위에서 할 수 있는 일이 아닙니다.
//
// 발동 시점은 ramp_on_return 과 정확히 같습니다 - 같은 전환 엣지, 같은 주기.
// 다만 서로 껐다 켜지는 관계는 아닙니다: ramp_on_return.topic 을 비워도 이쪽은
// 그대로 돕니다.
//
// 코너 홀드가 복귀를 막고 있는 동안에는 발동하지 않습니다. 그때는 복귀 자체가
// 없기 때문이고, 이것은 지도 컨트롤러가 "시작하는" 순간에 하는 일입니다.
//
// 경로:  -p return_assist_file:=<share>/config/return_assist.jsonc
// 파일을 안 주거나 enabled 를 false 로 두면 이 JSON의 speed_hold와 이득 보정은
// 둘 다 꺼집니다. YAML의 ramp_on_return은 별도 안전 fallback이라 그대로 동작합니다.
{
  "enabled": true,

  // 파라미터를 바꿀 노드. 네임스페이스를 포함한 전체 이름이어야 하고,
  // <node>/get_parameters 와 <node>/set_parameters_atomically 를 씁니다.
  "node": "/pure_pursuit",

  // 이만큼보다 크게 꺾고 있을 때만 돕니다. 이미 정렬돼 있으면 이득을 올릴
  // 이유가 없고, 올리면 잡음만 증폭됩니다.
  "steering_above_deg": 15.0,

  // 무엇을 원래 값의 몇 배로 둘지. 셋은 함께 올라갔다가 함께 돌아옵니다 -
  // 하나만 읽히고 다음에서 실패하면 원래 값을 아무도 안 적어둔 채로 이득이
  // 올라간 상태가 남기 때문에, 읽기도 쓰기도 전부 아니면 전무입니다.
  //
  //   K_d                 오차가 닫히는 속도에 작용합니다. 붙는 동안만 세게.
  //   K_p                 오차 자체에 작용합니다. 멀리 있을수록 크게 당깁니다.
  //   heading_error_gain  자세 오차의 몫. 복귀 직후가 정확히 그 오차가 큰
  //                       순간입니다.
  //
  // 아래 배수들은 차에서 확인하며 여기서 조정합니다.
  "parameters": {
    "K_d": 1.2,
    "K_p": 0.85,
    "heading_error_gain": 1.0
  },

  // 얼마 동안 올려둘지.
  "hold_ms": 800,

  // 새 hold 세션의 첫 handback 뒤 선택이 중간 재전환 없이 이어지고 아래 전제들이
  // 유지되면, 요청 시점 모델상 최종 /drive가 목표 속도에 도달한 시점부터
  // duration_ms 이상의 steady 시간 예산을 둡니다.
  // 즉 duration_ms 는 pure_pursuit 에 그대로 보내는 시간이 아니라,
  // switch_blend/rate_limit 전이가 끝난 뒤 확보하려는 조건부 최소 steady 시간입니다.
  // 전이예산은 보수적인 상한이라 실제 steady 시간은 더 길 수 있습니다.
  // 이 계산은 다음을 전제로 하며 co_driver가 확인하거나 acknowledge 받지 않습니다.
  //   - 요청 뒤 postprocess reload나 runtime speed_scale 변경이 없을 것
  //   - pure_pursuit가 요청 값을 clamp/거부하지 않고 출력 주기를 계속 만들 것
  //   - Path/RF의 max_speed_limit_percentage 등이 목표 속도를 더 낮추지 않을 것
  //
  // pure_pursuit 의 /launch_speed_hold 는 [속도, 시간] 을 받아 그 속도로 고정했다가
  // 시간이 지나면 **그 속도에서 곧바로 램프업**으로 넘어갑니다. 그래서 이걸 켜면
  // 램프업을 따로 요청할 필요가 없습니다 - 오히려 보내면 안 됩니다. 컨트롤러는
  // 가장 최근 입력을 이기는 것으로 처리하므로, hold 뒤에 /launch_start_reset 을
  // 보내면 hold 가 취소됩니다. 그래서 정상 hold 요청이 나간 경우에는 램프 플래그를
  // 같이 보내지 않습니다. 단, 아래 상한 안에서 steady 시간을 보장할 수 없으면
  // hold 를 보내지 않고 기존 ramp_on_return 신호로 fallback 합니다.
  //
  // 이득을 올려두는 위 hold_ms 와 같은 복귀 엣지에서 시작하지만, 지속 시간은
  // 독립적으로 조절합니다. duration_ms 를 생략한 예전 설정은 호환성을 위해 위의
  // hold_ms 를 그대로 사용합니다.
  //
  // co_driver 가 pure_pursuit 에 보내는 시간은 자동으로 더 깁니다:
  //
  //   전송 시간 = duration_ms + switch_blend 상한 + speed rate-limit 정착 상한
  //
  // rate-limit 상한은 handback 순간의 한 샘플만 보지 않고, 최종 clamp 범위의 양
  // 끝점에서 hold 속도까지 오는 최악 거리로 계산합니다. /Path 가 끊겨 PP의 hold
  // 시계는 멈췄지만 co_driver 출력은 예전 PP 명령 쪽으로 계속 움직이는 경우까지
  // 포함하기 위해서입니다. 현재 [0, 8] clamp, 6.0 속도 rate, 3.7 hold 에서는
  // 100 ms blend + 4.3/6.0 s = 약 0.817 s를 더해, 800 ms steady 설정을 약
  // 1.617 s 요청으로 보냅니다.
  //
  // EMA blend처럼 유한 종료시간이 없거나, rate-limit이 있는데 최종 속도 clamp가
  // 없거나, 요청 시점의 speed_scale/deadband/clamp가 hold 속도 자체를 바꾸는
  // 설정이면 시간을 추측하지 않고 ramp fallback을 사용합니다. 요청을 보낸 뒤의
  // runtime parameter 변경이나 reload는 감시해서 재계산하지 않으므로 hold 세션
  // 사이에서만 조정하세요.
  //
  // pure_pursuit 의 유지 시간은 벽시계 마감이 아니라 **실제로 유지한 시간**을
  // 셉니다 - 출력이 나가는 주기에만 누적됩니다. /Path 가 끊기면 그쪽 시계는
  // 멈추고 co_driver 의 중복 방지 타이머는 안 멈춥니다. status의 speed_hold.left_s와
  // local_suppression_left_s는 이 로컬 타이머이지 PP가 알려준 잔여 시간이 아닙니다.
  // PP가 오래 멈추면 로컬 타이머가 먼저 끝나 다음 handback이 hold를 다시 보낼 수도
  // 있으므로, 그 경우 steady 시간이나 중복 억제를 절대적으로 보장하지 않습니다.
  // /Path 가 50 Hz 로 들어오는 0822 합동 시험에서는 둘의 차이가 마이크로초 수준이었습니다.
  //
  // 이득을 "램프가 끝날 때까지" 올려두고 싶다면 그건 다른 사양입니다. 지금은
  // 복귀 직후의 자세 오차를 위한 것이고, 그 오차는 처음이 가장 큽니다.
  //
  // 이득 보정(위)과 달리 조향각을 보지 않습니다. 이건 램프 플래그가 하던 일을
  // 대신하는 것이고, 그건 복귀할 때마다 나갔습니다. 조향이 큰 경우에만 보내면
  // 똑바로 복귀하는 경우가 유지도 램프업도 없이 남습니다.
  //
  // 어떤 후보에서 돌아올 때 발동하는지는 여기가 아니라 co_driver_red_damvi.yaml
  // 의 ramp_on_return.from 이 정합니다. 유지, YAML 램프 플래그, 이득 보정이
  // 전부 같은 엣지에 매달려 있어서, 거기에 이름을 하나 넣으면
  // 셋 다에 들어갑니다. 지금은 gap_loc 와 gap_obs 둘 다입니다.
  //
  // 속도 단위는 명령 속도 도메인입니다 (LAUNCH_TOPICS.md 참고). 실제 차속으로는
  // 약 1/2.6 수준입니다.
  //
  // 받는 쪽이 강제하는 한계 (pure_pursuit, 2026-08-23 확인):
  //   speed     0 이상 speed_hold_max_speed(8.0) 이하, 유한한 값
  //   duration  0 이상 speed_hold_max_duration(10.0) 이하. 넘으면 잘리고,
  //             0 이면 유지 없이 그 속도에서 곧바로 램프업입니다.
  // max_request_duration_ms 는 받는 쪽 값을 조회한 결과가 아니라 로컬 설정 가정이며,
  // 그 받는 쪽 상한과 반드시 맞춰야 합니다. 자동으로
  // 계산한 전송 시간이 이를 넘으면, 받는 쪽 clamp 때문에 steady 시간이 짧아지지
  // 않도록 hold 요청을 아예 보내지 않고 ramp fallback을 사용합니다.
  // speed_hold_max_speed나 duration 상한을 PP에서 런타임 변경해도 co_driver는 모르며,
  // 요청 speed가 허용돼도 Path/RF max_speed_limit_percentage 상한은 최종 PP 명령을
  // 더 낮출 수 있습니다. status의 receiver_acknowledged/receiver_limits_verified가
  // false인 이유이며, 이 경우 위 조건부 steady 모델은 성립하지 않습니다.
  //
  // 그리고 유지 중에 또 보내면 **최신 것이 이겨서 유지가 처음부터 다시 시작됩니다.**
  // 받는 쪽에는 중복을 막는 장치가 없습니다 - 진행 중인 유지를 다시 걸지 않는
  // 것은 전적으로 이쪽 책임입니다. 0822 합동 시험에서 중재가 2.3초에 여섯 번
  // 흔들려 유지가 세 번 걸렸고, 차가 2.0초가 아니라 3.39초를 1.5 m/s 에 묶였습니다.
  // 그래서 co_driver의 로컬 중복 방지 시간 안에는 다른 후보로 갔다가 다시
  // handback해도 세션을 재시작하지 않으며, 그 반복 handback에 대해서는 위 조건부
  // 최소 steady 시간이 새로 확보되지 않습니다. PP 시계가 멈춰 로컬 시간이 먼저
  // 끝나는 경우는 위 설명처럼 다시 전송될 수 있습니다.
  "speed_hold": {
    "enabled": true,
    "topic": "/launch_speed_hold",
    "speed": 3.7,
    "duration_ms": 800,
    "max_request_duration_ms": 10000
  },

  // 파라미터 서비스가 이 안에 응답하지 않으면 포기합니다.
  //
  // 현재 값을 못 읽으면 아예 올리지 않습니다. 되돌릴 값을 모르는 채로 이득을
  // 올려두는 것이 이 기능이 낼 수 있는 최악의 결과이기 때문입니다.
  "service_timeout_ms": 500
}
