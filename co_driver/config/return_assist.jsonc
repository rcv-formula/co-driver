// 복귀 직후 잠깐만 도와주는 값들.
//
// gap_loc 에서 pp_main 으로 차를 돌려주는 그 순간, 지도 컨트롤러가 이미 크게
// 꺾어달라고 하고 있으면 - 즉 차가 자기가 원하는 자세에서 멀리 있으면 - 미분
// 이득을 잠깐 올렸다가 되돌립니다. 붙는 동안만 반응을 세게 하고, 붙고 나면
// 원래 값으로 돌아가야 하니 시간 제한이 있는 것입니다.
//
// co_driver 안에서 계산하는 게 아니라 상대 노드의 ROS 파라미터를 바꿉니다.
// pure_pursuit 은 K_d 를 런타임 변경 대상으로 열어두고 있고 (USAGE_GUIDE.md 의
// kRuntimeParameterNames), 바꾼 값은 다음 제어 주기부터 반영됩니다.
//
// 별도 스레드에서 돕니다. 파라미터 서비스 왕복은 수십 ms 가 걸릴 수 있고,
// hold_ms 동안 기다려야 하므로 판단 주기 위에서 할 수 있는 일이 아닙니다.
//
// 발동 시점은 ramp_on_return 과 정확히 같습니다 - 같은 전환 엣지, 같은 주기.
// 다만 서로 껐다 켜지는 관계는 아닙니다: ramp_on_return.topic 을 비워도 이쪽은
// 그대로 돕니다.
//
// 코너 홀드가 복귀를 막고 있는 동안에는 발동하지 않습니다. 그때는 복귀 자체가
// 없기 때문이고, 이것은 지도 컨트롤러가 "시작하는" 순간에 하는 일입니다.
//
// 경로:  -p return_assist_file:=<share>/config/return_assist.jsonc
// 파일을 안 주거나 enabled 를 false 로 두면 아무 일도 하지 않습니다.
{
  "enabled": true,

  // 파라미터를 바꿀 노드. 네임스페이스를 포함한 전체 이름이어야 하고,
  // <node>/get_parameters 와 <node>/set_parameters_atomically 를 씁니다.
  "node": "/pure_pursuit",

  // 이만큼보다 크게 꺾고 있을 때만 돕니다. 이미 정렬돼 있으면 이득을 올릴
  // 이유가 없고, 올리면 잡음만 증폭됩니다.
  "steering_above_deg": 15.0,

  // 무엇을 원래 값의 몇 배로 둘지. 셋은 함께 올라갔다가 함께 돌아옵니다 -
  // 하나만 읽히고 다음에서 실패하면 원래 값을 아무도 안 적어둔 채로 이득이
  // 올라간 상태가 남기 때문에, 읽기도 쓰기도 전부 아니면 전무입니다.
  //
  //   K_d                 오차가 닫히는 속도에 작용합니다. 붙는 동안만 세게.
  //   K_p                 오차 자체에 작용합니다. 멀리 있을수록 크게 당깁니다.
  //   heading_error_gain  자세 오차의 몫. 복귀 직후가 정확히 그 오차가 큰
  //                       순간입니다.
  //
  // K_d 의 2.0 을 빼면 아래 배수들은 아직 측정한 값이 아니라 출발점입니다.
  // 차에서 보고 여기서만 고치면 됩니다.
  "parameters": {
    "K_d": 2.0,
    "K_p": 1.5,
    "heading_error_gain": 1.5
  },

  // 얼마 동안 올려둘지.
  "hold_ms": 2000,

  // 돌려주는 그 hold_ms 동안 고정 속도를 유지시킵니다.
  //
  // pure_pursuit 의 /launch_speed_hold 는 [속도, 시간] 을 받아 그 속도로 고정했다가
  // 시간이 지나면 **그 속도에서 곧바로 램프업**으로 넘어갑니다. 그래서 이걸 켜면
  // 램프업을 따로 요청할 필요가 없습니다 - 오히려 보내면 안 됩니다. 컨트롤러는
  // 가장 최근 입력을 이기는 것으로 처리하므로, hold 뒤에 /launch_start_reset 을
  // 보내면 hold 가 취소됩니다. 그래서 이게 켜져 있으면 램프 플래그는 자동으로
  // 안 나갑니다 (ramp_on_return 설정과 무관하게).
  //
  // 지속 시간은 위의 hold_ms 를 그대로 씁니다. 같은 순간, 같은 2초이고, 숫자를
  // 두 군데 적어두면 언젠가 갈라지기 때문입니다.
  //
  // 다만 "같은 2초"가 보장되는 건 아닙니다. pure_pursuit 의 유지 시간은 벽시계
  // 마감이 아니라 **실제로 유지한 시간**을 셉니다 - 출력이 나가는 주기에만
  // 누적됩니다. /Path 가 끊기면 그쪽 시계는 멈추고 이쪽 2초 타이머는 안 멈추므로,
  // 게인이 먼저 복구되고 램프가 나중에 시작될 수 있습니다. 0822 합동 시험에서
  // /Path 가 50 Hz 로 들어오는 동안에는 마이크로초 차이였지만, 경로가 끊기는
  // 순간은 정확히 반응형 컨트롤러가 차를 잡고 있던 이유이기도 해서 상관이 있습니다.
  //
  // 이득을 "램프가 끝날 때까지" 올려두고 싶다면 그건 다른 사양입니다. 지금은
  // 복귀 직후의 자세 오차를 위한 것이고, 그 오차는 처음이 가장 큽니다.
  //
  // 이득 보정(위)과 달리 조향각을 보지 않습니다. 이건 램프 플래그가 하던 일을
  // 대신하는 것이고, 그건 복귀할 때마다 나갔습니다. 조향이 큰 경우에만 보내면
  // 똑바로 복귀하는 경우가 유지도 램프업도 없이 남습니다.
  //
  // 어떤 후보에서 돌아올 때 발동하는지는 여기가 아니라 co_driver_red_damvi.yaml
  // 의 ramp_on_return.from 이 정합니다. 이 파일의 세 동작(유지, 램프 플래그,
  // 이득 보정)이 전부 같은 엣지에 매달려 있어서, 거기에 이름을 하나 넣으면
  // 셋 다에 들어갑니다. 지금은 gap_loc 와 gap_obs 둘 다입니다.
  //
  // 속도 단위는 명령 속도 도메인입니다 (LAUNCH_TOPICS.md 참고). 실제 차속으로는
  // 약 1/2.6 수준입니다.
  //
  // 받는 쪽이 강제하는 한계 (pure_pursuit, 2026-08-23 확인):
  //   speed     0 이상 speed_hold_max_speed(8.0) 이하, 유한한 값
  //   duration  0 이상 speed_hold_max_duration(10.0) 이하. 넘으면 잘리고,
  //             0 이면 유지 없이 그 속도에서 곧바로 램프업입니다.
  // 위 hold_ms 가 duration 이 되므로 10초를 넘기지 마세요.
  //
  // 그리고 유지 중에 또 보내면 **최신 것이 이겨서 유지가 처음부터 다시 시작됩니다.**
  // 받는 쪽에는 중복을 막는 장치가 없습니다 - 진행 중인 유지를 다시 걸지 않는
  // 것은 전적으로 이쪽 책임입니다. 0822 합동 시험에서 중재가 2.3초에 여섯 번
  // 흔들려 유지가 세 번 걸렸고, 차가 2.0초가 아니라 3.39초를 1.5 m/s 에 묶였습니다.
  "speed_hold": {
    "enabled": true,
    "topic": "/launch_speed_hold",
    "speed": 1.5
  },

  // 파라미터 서비스가 이 안에 응답하지 않으면 포기합니다.
  //
  // 현재 값을 못 읽으면 아예 올리지 않습니다. 되돌릴 값을 모르는 채로 이득을
  // 올려두는 것이 이 기능이 낼 수 있는 최악의 결과이기 때문입니다.
  "service_timeout_ms": 500
}
