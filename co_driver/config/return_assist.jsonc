// 복귀 직후 잠깐만 도와주는 값들.
//
// gap_loc 에서 pp_main 으로 차를 돌려주는 그 순간, 지도 컨트롤러가 이미 크게
// 꺾어달라고 하고 있으면 - 즉 차가 자기가 원하는 자세에서 멀리 있으면 - 미분
// 이득을 잠깐 올렸다가 되돌립니다. 붙는 동안만 반응을 세게 하고, 붙고 나면
// 원래 값으로 돌아가야 하니 시간 제한이 있는 것입니다.
//
// co_driver 안에서 계산하는 게 아니라 상대 노드의 ROS 파라미터를 바꿉니다.
// pure_pursuit 은 K_d 를 런타임 변경 대상으로 열어두고 있고 (USAGE_GUIDE.md 의
// kRuntimeParameterNames), 바꾼 값은 다음 제어 주기부터 반영됩니다.
//
// 별도 스레드에서 돕니다. 파라미터 서비스 왕복은 수십 ms 가 걸릴 수 있고,
// hold_ms 동안 기다려야 하므로 판단 주기 위에서 할 수 있는 일이 아닙니다.
//
// 발동 시점은 ramp_on_return 과 정확히 같습니다 - 같은 전환 엣지, 같은 주기.
// 다만 서로 껐다 켜지는 관계는 아닙니다: ramp_on_return.topic 을 비워도 이쪽은
// 그대로 돕니다.
//
// 코너 홀드가 복귀를 막고 있는 동안에는 발동하지 않습니다. 그때는 복귀 자체가
// 없기 때문이고, 이것은 지도 컨트롤러가 "시작하는" 순간에 하는 일입니다.
//
// 경로:  -p return_assist_file:=<share>/config/return_assist.jsonc
// 파일을 안 주거나 enabled 를 false 로 두면 아무 일도 하지 않습니다.
{
  "enabled": true,

  // 파라미터를 바꿀 노드와 이름. 노드 이름은 네임스페이스를 포함한 전체
  // 이름이어야 하고, 서비스는 <node>/get_parameters 와 <node>/set_parameters
  // 를 씁니다.
  "node": "/pure_pursuit",
  "parameter": "K_d",

  // 이만큼보다 크게 꺾고 있을 때만 돕니다. 이미 정렬돼 있으면 미분 이득을
  // 올릴 이유가 없고, 올리면 잡음만 증폭됩니다.
  "steering_above_deg": 15.0,

  // 원래 값에 이만큼 곱합니다. 0 보다 큰 값이어야 하고, 1.0 이면 아무것도
  // 바꾸지 않는 것과 같습니다.
  "multiply_by": 2.0,

  // 얼마 동안 올려둘지.
  "hold_ms": 2000,

  // 파라미터 서비스가 이 안에 응답하지 않으면 포기합니다.
  //
  // 현재 값을 못 읽으면 아예 올리지 않습니다. 되돌릴 값을 모르는 채로 이득을
  // 올려두는 것이 이 기능이 낼 수 있는 최악의 결과이기 때문입니다.
  "service_timeout_ms": 500
}
