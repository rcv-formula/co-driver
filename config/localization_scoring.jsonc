// How the localization score is computed - the scorers' own parameters.
//
// Deep-merged over co_driver_red_damvi_topics.jsonc at load (`tuning_file`
// parameter). Only scorer behaviour lives here; the arbitration layer -
// weights, bias, response curves, veto placement - is co_driver's and stays
// in the topics file. Reload without restarting:
//
//   ros2 service call /co_driver_node/reload std_srvs/srv/Trigger
{
  "inputs": {
    "localization": {
      "params": {
        // raw units -> [0,1]; the producer already emits [0,1]
        "input_min": 0.0,
        "input_max": 1.0,
        "invert": false,
        // publisher runs at 100 Hz -> 20 periods
        "timeout_ms": 200,
        // dead topic = confidence 0 (a silent localization IS a failed one)
        "on_missing": "value",
        "default_score": 0.0
      }
    },

    "loc_state": {
      // latched topic, republished on transitions only -> staleness off
      "params": {"timeout_ms": 0}
    },

    "loc_trip": {
      // Early handover: confidence < trip_below sustained trip_ms disqualifies
      // pp_main. This is where "detect earlier" lives - the user's 0.50.
      //   trip_below 0.50 : the score pathway only fires at 0.171; this bar
      //                     catches the quiet degradations (0.25-0.45 hover)
      //                     the curve saturation hides. Tuned for a course
      //                     where healthy confidence stays high - on a scene
      //                     like busan2 (13.5% of healthy tracking below 0.5)
      //                     it will trip during good driving; lengthen trip_ms
      //                     or lower the bar per track.
      //   trip_ms 500     : a momentary dip proves nothing (confidence is
      //                     noisy even when the pose is right); only a
      //                     sustained stay below the bar is a degradation.
      //                     Tolerance lives HERE, not in lowering the bar.
      //   clear_ms 2500   : the trip releases only after confidence has been
      //                     back above the bar for this long - time verifies
      //                     the recovery too, mirroring the recovery latch.
      "params": {
        "trip_below": 0.50,
        "trip_ms": 500,
        "clear_ms": 2500,
        "timeout_ms": 300
      }
    },

    "recovery": {
      // Return latch, anchored at the global-search ATTACH (Lost->Converging
      // entry), not at full convergence. The verification is the dwell plus
      // the confidence bar together: measured over 17 attaches, a wrong one
      // decays (0.466 -> 0.38 @1s -> 0.29 @2s, dead at 2.8 s) and breaks the
      // hold at ~1.4 s, while correct ones sit flat at 0.48+.
      //
      //   min_state 1        : attached (Converging) is enough - no waiting
      //                        for Tracking (attach->Tracking median is 3.5 s,
      //                        up to 12.4 s, so this halves the return time)
      //   min_confidence 0.35: the working range is 0.25-0.35. Both edges are
      //                        load-bearing:
      //                        - do NOT raise it: Converging confidence is
      //                          capped at 0.5 x dominant hypothesis mass, so
      //                          a bar >= ~0.45 can never be met before
      //                          Tracking and the attach anchor silently dies
      //                          (a 0.50 setting pinned a test car on
      //                          gap_follow; the node now warns about this).
      //                        - do NOT lower it much: the dwell alone cannot
      //                          reject a bad attach (one survived 2.8 s);
      //                          this bar is what catches the decay.
      //                        On a perceptually aliased course (symmetric
      //                        sections), even a CORRECT attach sits at
      //                        conf <= 0.5 x mass (balanced twins -> <= 0.25)
      //                        until the hypotheses are discriminated, so the
      //                        car stays on gap_follow through the ambiguity.
      //                        That is intended: an undiscriminated twin means
      //                        the raceline may be the worst possible path.
      //                        Matches in_max in the topics file - keep them
      //                        in step.
      //   hold_ms 2500       : the measured bad attach breaks the hold at
      //                        ~1.4 s; 2.5 s adds margin over the single
      //                        recorded sample (n=1 - be conservative).
      "params": {
        "min_state": 1,
        "min_confidence": 0.35,
        "hold_ms": 2500,
        "confidence_timeout_ms": 300
      }
    }
  }
}
