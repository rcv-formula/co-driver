// red_damvi wiring + arbitration parameters.
//
// One line: **when localization collapses, hand over to gap_follow; come back
// only when it is fully healthy again.**
//
// This file owns everything that belongs to co_driver itself:
//   - which inputs and drives exist, and where they listen (wiring)
//   - the arbitration layer: weights W[j][i], bias b_j, response curves,
//     veto placements, per-drive hold_ms
//
// How the localization score itself is computed (timeouts, missing-topic
// policy, recovery-gate conditions) is the scorer's business and lives in
// config/localization_scoring.jsonc, merged over this file at load.
// Base settings (scoring / selection / postprocess) are in co_driver_red_damvi.yaml.
{
  "inputs": [
    {
      // /localization_confidence, published by both localization_pf and
      // slam_ours (absolute name in both, no prefix).
      //   std_msgs/Float64MultiArray, data = [stamp_sec, stamp_nanosec, confidence]
      "name": "localization",
      "type": "external_score",
      "params": {
        "topic": "/localization_confidence",
        "mode": "scalar",
        "index": 2,
        "stamp_indices": [0, 1]
      },
      // Response curve, shared default for all drives (overridden per drive below).
      // Fitted to measured confidence distributions (healthy-tracking p05 per
      // scene: icra .877 / 0522-2 .867 / 0526-1 .530 / busan2 .361 - the
      // thresholds must sit below the worst of them):
      //   in_min 0.02 : at or below this, score 0 (localization is gone)
      //   in_max 0.35 : at or above this, full marks (out of the danger band)
      // With the weights below and switch_margin 0.15 the handover lands at
      // confidence 0.171 falling / 0.226 rising. Re-fit if the producer's
      // confidence formula changes.
      "influence": {"weight": 0.0, "exp_mix": 1.0, "exp_k": 3.0, "in_min": 0.02, "in_max": 0.35}
    },

    {
      // Localization state machine: 0=Lost (or waiting for map), 1=Converging,
      // 2=Tracking. std_msgs/UInt8, latched, republished on transitions only.
      // Used as a gate, not a score: Lost instantly disqualifies pp_main.
      //
      // Topic name is per-stack: the real car (localization_pf) uses
      // /localization_pf/state, the slam_ours replay rig /slam_ours/state.
      // Silence closes the gate, so a wrong name pins the car on gap_follow -
      // loud and safe, never silently disabled.
      "name": "loc_state",
      "type": "localization_state",
      "params": {"topic": "/localization_pf/state"}
    },

    {
      // Early-degradation trip - the score curve saturates at in_max, so a
      // localization hovering at 0.25-0.45 (quietly wrong, not collapsed)
      // never reaches the score pathway's handover. This input watches the
      // raw confidence and disqualifies pp_main when it stays below the trip
      // bar for a sustained stretch (numbers in localization_scoring.jsonc).
      // Engaged only while Tracking - Lost/Converging belong to the state
      // veto and the recovery latch (a fresh attach legitimately sits below
      // the trip bar and must not be gated here).
      "name": "loc_trip",
      "type": "confidence_trip",
      "params": {
        "topic": "/localization_confidence",
        "index": 2,
        "state_topic": "/localization_pf/state"
      }
    },

    {
      // Return latch - keeps pp_main out until localization has been fully
      // healthy for a sustained stretch (conditions in localization_scoring.jsonc).
      "name": "recovery",
      "type": "recovery_gate",
      "params": {
        "confidence_topic": "/localization_confidence",
        "confidence_index": 2,
        "state_topic": "/localization_pf/state"
      }
    }
  ],

  // hold_ms = how long the last command stays trusted (~3-5x the topic period).
  // Past it the drive goes inactive and drops out of ranking and selection.
  "drives": [
    {
      // PPcontroller - map and raceline based; needs localization to mean anything
      "name": "pp_main",
      "topic": "/drive_main",
      "hold_ms": 300,
      "bias": 0.0,
      "enabled": true,
      "influence": {
        // W = +3.0: full confidence -> z = 3.0, zero confidence -> z = 0.0
        "localization": {"weight": 3.0, "exp_mix": 1.0, "exp_k": 3.0, "in_min": 0.02, "in_max": 0.35},
        // Lost (or silence) disqualifies pp_main outright; weight 0 = veto only
        "loc_state": {"weight": 0.0, "exp_mix": 0.0, "veto_below": 0.25},
        // early-degradation trip (see localization_scoring.jsonc); veto only
        "loc_trip": {"weight": 0.0, "exp_mix": 0.0, "veto_below": 0.5},
        // return latch (see localization_scoring.jsonc); weight 0 = veto only
        "recovery": {"weight": 0.0, "exp_mix": 0.0, "veto_below": 0.5}
      }
    },
    {
      // gap_follow - reactive on /scan alone; unaffected by localization.
      // bias 1.0 is its floor score when localization is gone; W = -1.5 makes
      // it step aside once confidence recovers (z = 1.0 - 1.5*phi).
      "name": "gap_follow",
      "topic": "/drive_gf",
      "hold_ms": 200,
      "bias": 1.0,
      "enabled": true,
      "influence": {
        "localization": {"weight": -1.5, "exp_mix": 1.0, "exp_k": 3.0, "in_min": 0.02, "in_max": 0.35}
      }
    }
  ]
}
